{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifecycleEnvelope",
  "description": "Versioned lifecycle document. Owner and events are required and cannot be null.\nJSON Schema validates fields; operation/entity ID separation is additionally\nenforced by Deserialize, since JSON Schema cannot compare arbitrary fields.",
  "type": "object",
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorId"
    },
    "checkout_id": {
      "$ref": "#/$defs/CheckoutId"
    },
    "delivery": {
      "$ref": "#/$defs/AttributionDelivery"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LifecycleEvent"
      }
    },
    "execution_chain": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionChain"
        },
        {
          "type": "null"
        }
      ]
    },
    "group_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/GroupId"
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle": {
      "$ref": "#/$defs/CheckoutLifecycle"
    },
    "mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "operation_id": {
      "$ref": "#/$defs/AllocationOperationId"
    },
    "owner": {
      "$ref": "#/$defs/OwnerId"
    },
    "parent_run_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "repository": {
      "$ref": "#/$defs/RepositoryId"
    },
    "run_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunId"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunOutcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "task": {
      "$ref": "#/$defs/TaskId"
    },
    "task_completion": {
      "$ref": "#/$defs/TaskCompletion"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "checkout_id",
    "actor",
    "repository",
    "task",
    "owner",
    "mode",
    "lifecycle",
    "delivery",
    "task_completion",
    "events"
  ],
  "$defs": {
    "ActorId": {
      "type": "string",
      "pattern": "[^\\t-\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    },
    "AllocationOperationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "AttributionDelivery": {
      "type": "string",
      "enum": [
        "not_configured",
        "pending",
        "delivered",
        "failed"
      ]
    },
    "ChainText": {
      "type": "string",
      "allOf": [
        {
          "pattern": "[^\\t-\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
        },
        {
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        }
      ],
      "maxLength": 4096
    },
    "CheckoutId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "CheckoutLifecycle": {
      "type": "string",
      "enum": [
        "reserved",
        "partially_created",
        "ready",
        "active",
        "expired",
        "interrupted",
        "held",
        "quarantined",
        "partially_deleted",
        "retired"
      ]
    },
    "EventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "ExecutionChain": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "orchestrator",
              "executor"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "items": {
        "$ref": "#/$defs/ExecutionEntry"
      },
      "maxItems": 32,
      "minItems": 1
    },
    "ExecutionEntry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "orchestrator"
            },
            "session_ref": {
              "$ref": "#/$defs/ChainText"
            },
            "system": {
              "$ref": "#/$defs/ChainText"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "system"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "executor"
            },
            "session_ref": {
              "$ref": "#/$defs/ChainText"
            },
            "system": {
              "$ref": "#/$defs/ChainText"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "system"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "model"
            },
            "model": {
              "$ref": "#/$defs/ChainText"
            },
            "provider": {
              "$ref": "#/$defs/ChainText"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "provider",
            "model"
          ]
        }
      ]
    },
    "ExecutionMode": {
      "type": "string",
      "enum": [
        "supervised",
        "adopted"
      ]
    },
    "ExpiryReason": {
      "type": "string",
      "enum": [
        "lease_ttl"
      ]
    },
    "GroupId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "HoldReason": {
      "type": "string",
      "enum": [
        "unpreserved_changes",
        "unknown_artifacts",
        "uncertain_writers",
        "incomplete_inspection",
        "preservation_unverified",
        "identity_mismatch"
      ]
    },
    "InterruptionReason": {
      "type": "string",
      "enum": [
        "execution_lost"
      ]
    },
    "LifecycleEvent": {
      "description": "Lifecycle journal events. Unknown required variants are rejected at parse time.\nThese payloads record evidence; no event alone authorizes retirement.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "group_id": {
              "$ref": "#/$defs/GroupId"
            },
            "id": {
              "$ref": "#/$defs/EventId"
            },
            "mode": {
              "$ref": "#/$defs/ExecutionMode"
            },
            "run_id": {
              "$ref": "#/$defs/RunId"
            },
            "type": {
              "type": "string",
              "const": "started"
            }
          },
          "required": [
            "type",
            "id",
            "run_id",
            "group_id",
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/EventId"
            },
            "outcome": {
              "$ref": "#/$defs/RunOutcome"
            },
            "run_id": {
              "$ref": "#/$defs/RunId"
            },
            "type": {
              "type": "string",
              "const": "finished"
            }
          },
          "required": [
            "type",
            "id",
            "run_id",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/EventId"
            },
            "reason": {
              "$ref": "#/$defs/HoldReason"
            },
            "type": {
              "type": "string",
              "const": "held"
            }
          },
          "required": [
            "type",
            "id",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/EventId"
            },
            "reason": {
              "$ref": "#/$defs/ExpiryReason"
            },
            "type": {
              "type": "string",
              "const": "expired"
            }
          },
          "required": [
            "type",
            "id",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/EventId"
            },
            "reason": {
              "$ref": "#/$defs/InterruptionReason"
            },
            "type": {
              "type": "string",
              "const": "interrupted"
            }
          },
          "required": [
            "type",
            "id",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "checkout_id": {
              "$ref": "#/$defs/CheckoutId"
            },
            "id": {
              "$ref": "#/$defs/EventId"
            },
            "reason": {
              "$ref": "#/$defs/RetirementReason"
            },
            "type": {
              "type": "string",
              "const": "retired"
            }
          },
          "required": [
            "type",
            "id",
            "checkout_id",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/EventId"
            },
            "reason": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "attribution_gap"
            }
          },
          "required": [
            "type",
            "id",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/OwnerId"
            },
            "id": {
              "$ref": "#/$defs/EventId"
            },
            "over_quota": {
              "type": "boolean"
            },
            "to": {
              "$ref": "#/$defs/OwnerId"
            },
            "type": {
              "type": "string",
              "const": "owner_escalation"
            }
          },
          "required": [
            "type",
            "id",
            "from",
            "to",
            "over_quota"
          ]
        },
        {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string"
            },
            "id": {
              "$ref": "#/$defs/EventId"
            },
            "type": {
              "type": "string",
              "const": "inspection"
            }
          },
          "required": [
            "type",
            "id",
            "digest"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/EventId"
            },
            "inspection_digest": {
              "type": "string"
            },
            "operator": {
              "$ref": "#/$defs/ActorId"
            },
            "type": {
              "type": "string",
              "const": "approval"
            }
          },
          "required": [
            "type",
            "id",
            "operator",
            "inspection_digest"
          ]
        },
        {
          "type": "object",
          "properties": {
            "detail": {
              "type": "string"
            },
            "id": {
              "$ref": "#/$defs/EventId"
            },
            "type": {
              "type": "string",
              "const": "reconciliation"
            }
          },
          "required": [
            "type",
            "id",
            "detail"
          ]
        }
      ]
    },
    "OwnerId": {
      "type": "string",
      "pattern": "[^\\t-\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    },
    "RepositoryId": {
      "type": "string",
      "pattern": "[^\\t-\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    },
    "RetirementReason": {
      "type": "string",
      "enum": [
        "absence_confirmed"
      ]
    },
    "RunId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "RunOutcome": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "RunRef": {
      "type": "string",
      "pattern": "[^\\t-\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    },
    "SchemaVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$"
    },
    "TaskCompletion": {
      "type": "string",
      "enum": [
        "open",
        "finished"
      ]
    },
    "TaskId": {
      "type": "string",
      "pattern": "[^\\t-\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    }
  }
}
