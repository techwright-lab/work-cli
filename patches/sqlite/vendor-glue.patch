+// This vendored crate is Work's exact reviewed Darwin persistence mechanism.
+// Check the TARGET (not the build host), before any system-library escape path.
+fn verify_work_darwin_source() -> bool {
+    if !env::var("CARGO_CFG_TARGET_OS").is_ok_and(|os| os == "macos") {
+        return false;
+    }
+    assert!(
+        cfg!(feature = "bundled")
+            && !cfg!(any(
+                feature = "sqlcipher",
+                feature = "bundled-sqlcipher",
+                feature = "in_gecko",
+                feature = "loadable_extension"
+            ))
+            && !env::var_os("LIBSQLITE3_SYS_USE_PKG_CONFIG").is_some_and(|v| v != "0"),
+        "Work requires exact patched bundled SQLite; system/alternate SQLite is not permitted"
+    );
+    use sha2::Digest;
+    for (path, expected) in [
+        (
+            "sqlite3/sqlite3.c",
+            "542f88e2bcc33b127fba330b10cc1aab2ddcfdabd5a47fc1ef6eeb55e4328c7a",
+        ),
+        (
+            "sqlite3/sqlite3.h",
+            "4340a24cda7bc436d62459c3c5237f67b9ab716ddca872faf8052d0ce0d97119",
+        ),
+        (
+            "sqlite3/sqlite3ext.h",
+            "ea81fb7bd05882e0e0b92c4d60f677b205f7f1fbf085f218b12f0b5b3f0b9e48",
+        ),
+        (
+            "sqlite3/bindgen_bundled_version.rs",
+            "cf53846904130e42d81072cd63302c6d9261f45a9842c3a4093235c072398528",
+        ),
+        (
+            "sqlite3/bindgen_bundled_version_ext.rs",
+            "31fed0b8f4b2d4cad09111d32e2e3e91f70e08129f50684667ea086e3b5fade7",
+        ),
+    ] {
+        println!("cargo:rerun-if-changed={path}");
+        let bytes = std::fs::read(path).expect("Work SQLite source is missing");
+        assert_eq!(
+            format!("{:x}", sha2::Sha256::digest(bytes)),
+            expected,
+            "Work SQLite source drift: {path}; upgrade requires re-review"
+        );
+    }
+    true
+}
