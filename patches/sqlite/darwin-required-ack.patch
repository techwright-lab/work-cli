+#if defined(__APPLE__)
+/* Work's required namespace acknowledgement. A sandbox no-op is not an ACK. */
+static int unixSyncDirectory(const char *zPath, unixFile *pFile){
+  int fd = -1;
+  int rc = osOpenDirectory(zPath, &fd);
+  if( rc!=SQLITE_OK ) return rc;
+  if( fd<0 ) return unixLogError(SQLITE_CANTOPEN_BKPT, "openDirectory", zPath);
+  rc = full_fsync(fd, 1, 0);
+  if( rc ){
+    if( pFile ) storeLastErrno(pFile, errno);
+    rc = unixLogError(SQLITE_IOERR_DIR_FSYNC, "full_fsync", zPath);
+  }
+  robust_close(pFile, fd, __LINE__);
+  return rc;
+}
+#endif
